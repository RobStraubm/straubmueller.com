---
// Version F: the email set large, then the small print in one row of labels.
---

<footer class="ff">
  <p class="ff-label">Write to me</p>
  <a class="ff-mail" href="mailto:robert@straubmueller.com">robert@straubmueller.com</a>
  <div class="ff-row">
    <p>Konstanz, Germany</p>
    <p>
      <a href="https://www.linkedin.com/in/robert-straubmueller">LinkedIn ↗</a>
      <a href="https://github.com/RobStraubm">GitHub ↗</a>
    </p>
    <p>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="https://github.com/RobStraubm/straubmueller.com">Source ↗</a>
    </p>
  </div>
</footer>

<style>
  .ff {
    margin-top: clamp(80px, 10vw, 160px);
    padding: 0 var(--m) 64px;
    border-top: 1px solid var(--ink);
  }

  .ff-label,
  .ff-row {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ff-label {
    margin: 16px 0 0;
    color: var(--mute);
  }

  .ff-mail {
    display: inline-block;
    margin: 8px 0 48px;
    font-size: clamp(30px, 5.4vw, 92px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
  }

  .ff-mail:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .ff-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px var(--m);
  }

  .ff-row p {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
  }

  .ff-row p:last-child {
    justify-content: flex-end;
  }

  .ff-row a {
    text-decoration: none;
  }

  .ff-row a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .ff-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .ff-row p:last-child {
      justify-content: flex-start;
    }
  }
</style>
