---
// A real screen or page, shown as it is, in one frame for every case: a 1px border and a mono bar naming where it
// comes from. The image itself is never retouched. Without `src`, the frame holds a redrawn screen from its slot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  source: string;
  label?: string;
  widths?: number[];
  sizes?: string;
}

const { src, alt, source, label, widths, sizes } = Astro.props;
---

<div class="shot">
  <div class="shot-bar" aria-hidden="true">
    <span>{source}</span>
    {label && <span>{label}</span>}
  </div>
  {src ? <Image src={src} alt={alt ?? ''} widths={widths} sizes={sizes} loading="lazy" /> : <slot />}
</div>

<style>
  .shot {
    border: 1px solid var(--ink);
    background: var(--ink);
  }

  .shot-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 10px;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 1.3;
    color: var(--mute);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
