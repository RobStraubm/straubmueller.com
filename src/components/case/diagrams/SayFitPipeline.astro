---
// SayFit's pipeline in the site's style, redrawn from ~/Desktop/Job/sayfit-showcase/docs/pipeline.svg. Steps marked
// `mine` are Robert's part: prompts and evaluation of both LLM steps, the ontology filter, retrieval quality, web UI.
const steps = [
  { n: '0', title: 'Voice or text', note: '“2 scrambled eggs and a banana”, transcribed by Whisper' },
  { n: '1 · LLM', title: 'Extraction', note: 'Foods, quantities, category ranks', mine: true },
  { n: '1.5', title: 'Ontology filter', note: 'Categories and portion hints', mine: true },
  { n: '2', title: 'Retrieval', note: 'Multi-query search over 1.88 million entries, category boosts', mine: true },
  { n: '3 · LLM', title: 'Rerank', note: 'Best match, grams, confidence', mine: true },
  { n: '4', title: 'Review', note: 'The user checks and corrects in the web UI', mine: true },
  { n: '5', title: 'Logbook', note: 'Meals and daily macros' },
  { n: '6', title: 'Recipes', note: 'Suggestions that fill the remaining macros' },
];
---

<div class="sf">
  <ol class="sf-steps" aria-label="SayFit pipeline in eight steps; steps 1 to 4 are my part">
    {
      steps.map((step) => (
        <li class:list={{ 'is-mine': step.mine }}>
          <span class="sf-n">Step {step.n}</span>
          <strong>{step.title}</strong>
          <span class="sf-note">{step.note}</span>
        </li>
      ))
    }
  </ol>
  <div class="sf-key" aria-hidden="true">
    <span class="is-mine">My part</span>
    <span>Team</span>
  </div>
</div>

<style>
  .sf {
    font-size: 15px;
    line-height: 1.35;
  }

  .sf-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .sf .sf-steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 12px 14px 14px;
    border: 1px solid var(--hair);
    font-size: 15px;
    line-height: 1.35;
  }

  /* The arrow from one step to the next, inside a row. */
  .sf .sf-steps li:not(:nth-child(4n))::after {
    content: '→';
    position: absolute;
    right: -11px;
    top: 12px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--mute);
  }

  .sf .sf-steps li.is-mine {
    border-color: var(--ink);
    border-top: 2px solid var(--signal);
  }

  .sf-n,
  .sf-note {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--mute);
  }

  .is-mine .sf-n {
    color: var(--signal);
  }

  .sf strong {
    font-weight: 600;
  }

  .sf-key {
    display: flex;
    gap: 20px;
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--mute);
  }

  .sf-key span::before {
    content: '';
    display: inline-block;
    width: 18px;
    margin-right: 8px;
    vertical-align: middle;
    border-top: 1px solid var(--hair);
  }

  .sf-key .is-mine::before {
    border-top: 2px solid var(--signal);
  }

  @media (max-width: 760px) {
    .sf-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sf .sf-steps li::after {
      display: none;
    }
  }
</style>
