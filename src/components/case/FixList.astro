---
// What did not work and what changed because of it, one dated row each: the problem as it showed, the change, and,
// where there is one, the measured before and after. Rows marked `open` are problems that are not solved; they
// stay on the list.
interface Fix {
  date: string;
  broke: string;
  changed: string;
  /** Measured before → after, e.g. ['164 bars', '57 bars']. */
  numbers?: [string, string];
  open?: boolean;
}

interface Props {
  fixes: Fix[];
}

const { fixes } = Astro.props;
---

<ol class="fx">
  <li class="fx-head" aria-hidden="true">
    <span>When</span>
    <span>What didn’t work</span>
    <span>What changed</span>
    <span>Before → after</span>
  </li>
  {
    fixes.map((fix) => (
      <li class:list={['fx-row', { 'is-open': fix.open }]}>
        <time class="fx-date">{fix.date}</time>
        <p class="fx-broke">{fix.broke}</p>
        <p class="fx-changed">
          {fix.open && <span class="fx-tag">Still open · </span>}
          {fix.changed}
        </p>
        <p class="fx-num">
          {fix.numbers && (
            <>
              <s>{fix.numbers[0]}</s> <span aria-label="became">→</span> <strong>{fix.numbers[1]}</strong>
            </>
          )}
        </p>
      </li>
    ))
  }
</ol>

<style>
  /* :global(.c-body section) >: the case layout puts every child of a section in the text column; this one spans the grid. */
  :global(.c-body section) > .fx {
    grid-column: 1 / 13;
    margin: clamp(24px, 3vw, 48px) 0;
    padding: 0;
    list-style: none;
    position: relative;
    z-index: 1;
    background: var(--paper);
  }

  .fx .fx-head,
  .fx .fx-row {
    display: grid;
    grid-template-columns: var(--cols);
    gap: 0 var(--gap);
    margin: 0;
  }

  .fx .fx-head {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--mute);
  }

  .fx-head span:nth-child(1),
  .fx-date {
    grid-column: 1 / 3;
  }

  .fx-head span:nth-child(2),
  .fx .fx-broke {
    grid-column: 3 / 7;
  }

  .fx-head span:nth-child(3),
  .fx .fx-changed {
    grid-column: 7 / 11;
  }

  .fx-head span:nth-child(4),
  .fx .fx-num {
    grid-column: 11 / 13;
  }

  .fx .fx-row {
    padding: 14px 0 16px;
    border-bottom: 1px solid var(--hair);
  }

  .fx-date {
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--signal);
  }

  .fx .fx-broke,
  .fx .fx-changed,
  .fx .fx-num {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }

  .fx .fx-broke {
    color: var(--mute);
  }

  .fx .fx-num {
    font-family: var(--f-mono);
    font-size: 13px;
  }

  .fx-num s {
    color: var(--mute);
  }

  .fx-num strong {
    font-weight: 400;
    color: var(--ink);
  }

  .fx-tag {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--signal);
  }

  @media (max-width: 900px) {
    .fx .fx-head {
      display: none;
    }
    .fx .fx-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .fx-date,
    .fx .fx-broke,
    .fx .fx-changed,
    .fx .fx-num {
      grid-column: 1 / -1;
    }
    .fx .fx-broke::before {
      content: 'Didn’t work: ';
      font-family: var(--f-mono);
      font-size: 12px;
    }
    .fx .fx-changed::before {
      content: 'Changed: ';
      font-family: var(--f-mono);
      font-size: 12px;
      color: var(--mute);
    }
  }
</style>
