---
// Version A, About: statement, portrait with the approved paragraph, then the CV as ruled tables.
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import VariantSwitch from '../../../components/VariantSwitch.astro';
import { aboutText, strengths, experience, education, awards, languages } from '../../../data/cv';
import portrait from '../../../assets/variants/portrait.jpg';

const tables = [
  { n: 2, id: 'experience', title: 'Experience', items: experience },
  { n: 3, id: 'education', title: 'Education', items: education },
];
---

<Base
  title="About · Robert Straubmüller"
  description="Robert Straubmüller: ten years in design, from the family restaurant to UX research and AI engineering. Now co-founder of Levelwork."
>
  <section class="hero" aria-labelledby="about-statement">
    <h1 id="about-statement" class="statement">
      <span class="s">Ten years</span>{' '}<span class="g">in design,</span>{' '}<span class="s">now</span>{' '}<span
        class="g">co-founder.</span
      >
    </h1>
  </section>

  <section aria-labelledby="bio-h">
    <div class="sec-h">
      <p class="n" aria-hidden="true">1</p>
      <h2 id="bio-h">Background</h2>
    </div>
    <div class="bio">
      <figure class="bio-portrait">
        <Image
          src={portrait}
          alt="Robert Straubmüller, smiling, seated on a cantilever chair"
          widths={[400, 700, 1000]}
          sizes="(max-width: 760px) 70vw, 30vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <div class="bio-text">
        <p>{aboutText}</p>
        <ul class="strengths lbl" aria-label="What Robert brings">
          {strengths.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {
    tables.map((table) => (
      <section aria-labelledby={`${table.id}-h`}>
        <div class="sec-h">
          <p class="n" aria-hidden="true">
            {table.n}
          </p>
          <h2 id={`${table.id}-h`}>{table.title}</h2>
        </div>
        <ol class="cv">
          {table.items.map((item) => (
            <li>
              <span class="years lbl">{item.years}</span>
              <span class="title">{item.title}</span>
              <span class="org">
                {item.href ? <a href={item.href}>{item.org}&nbsp;↗</a> : item.org}
                {item.note && <span class="note">{item.note}</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <section aria-labelledby="awards-h">
    <div class="sec-h">
      <p class="n" aria-hidden="true">4</p>
      <h2 id="awards-h">Awards</h2>
    </div>
    <ol class="cv">
      {
        awards.map((award) => (
          <li>
            <span class="years lbl">{award.year}</span>
            <span class="title">{award.title}</span>
            <span class="org">{award.href ? <a href={award.href}>{award.for}&nbsp;↗</a> : award.for}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="languages-h">
    <div class="sec-h">
      <p class="n" aria-hidden="true">5</p>
      <h2 id="languages-h">Languages</h2>
    </div>
    <p class="langs">{languages.join(' · ')}</p>
  </section>

  <VariantSwitch />
</Base>

<style>
  .hero {
    padding: clamp(40px, 6vw, 104px) var(--m) clamp(28px, 3.4vw, 52px);
    background-image: linear-gradient(90deg, var(--hair) 1px, transparent 1px);
    background-size: calc((100% - 2 * var(--m)) / 12) 100%;
    background-position: var(--m) 0;
  }

  .statement {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(44px, 7.4vw, 140px);
    font-weight: 200;
    line-height: 0.92;
    letter-spacing: -0.02em;
    font-size-adjust: from-font;
    text-wrap: balance;
  }

  .statement .s {
    font-weight: 200;
    font-stretch: 62.5%;
  }

  .statement .g {
    font-family: var(--f-sans);
    font-weight: 850;
    letter-spacing: -0.035em;
  }

  @supports not (font-size-adjust: from-font) {
    .statement .g {
      font-size: 0.9em;
    }
  }

  .bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    border-bottom: 1px solid var(--ink);
  }

  .bio-portrait {
    margin: 0;
    border-right: 1px solid var(--ink);
  }

  .bio-portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .bio-text {
    align-self: end;
    padding: 24px var(--m);
  }

  .bio-text p {
    max-width: 50ch;
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(22px, 2vw, 30px);
    font-weight: 300;
    line-height: 1.3;
  }

  .strengths {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  /* CV rows: mono years, condensed serif titles, the place and a note in grotesk. */
  .cv {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv li {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 4px 14px;
    align-items: baseline;
    padding: 14px var(--m);
    border-bottom: 1px solid var(--ink);
  }

  .cv .years {
    white-space: nowrap;
  }

  .cv .title {
    font-family: var(--f-display);
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 300;
    font-stretch: 62.5%;
    line-height: 1.1;
  }

  .cv .org {
    font-size: 16px;
  }

  .cv .org a {
    text-decoration: none;
  }

  .cv .org a:hover {
    text-decoration: underline;
  }

  .cv .note {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    color: var(--mute);
  }

  .langs {
    margin: 0;
    padding: 16px var(--m) 72px;
    font-size: 18px;
  }

  @media (max-width: 760px) {
    .bio {
      grid-template-columns: minmax(0, 1fr);
    }
    .bio-portrait {
      max-width: 70%;
      border-right: 0;
    }
    .cv li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      background-size: calc((100% - 2 * var(--m)) / 6) 100%;
    }
  }
</style>
