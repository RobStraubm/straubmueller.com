---
// Draft variant G “Grid”: F's direction on light paper, after Right Hemisphere. A split hero with Robert
// large next to the words, then the selected work as a staggered grid of films in the Bauhaus style
// that play when they come into view, on phones too.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FHeader from '../../components/f/FHeader.astro';
import FFooter from '../../components/f/FFooter.astro';
import { awards } from '../../data/cv';
import { recent, brand, slug } from '../../data/projects';
import { selected } from '../../data/selected';
import portrait from '../../assets/variants/portrait.jpg';

const all = [...recent, ...brand];
const first = Math.floor(Math.min(...all.map((item) => item.start)));
---

<Base
  title="Robert Straubmüller · Version G"
  description="Robert Straubmüller researches, designs and builds software for people who are not experts. Co-founder of Levelwork, Konstanz."
  chrome={false}
>
  <FHeader slot="header" base="/varianten/g/" />

  <section class="g-hero" aria-labelledby="g-hero-h">
    <h1 id="g-hero-h" class="g-words">
      <span class="visually-hidden">I research, design and build software for people who are not experts.</span>
      <span class="g-word" aria-hidden="true"><span>Research</span></span>
      <span class="g-word" aria-hidden="true" style="--delay: 0.08s"><span>Design</span></span>
      <span class="g-word" aria-hidden="true" style="--delay: 0.16s"><span>Build</span></span>
    </h1>
    <figure class="g-me">
      <Image
        src={portrait}
        alt="Robert Straubmüller, smiling, seated on a cantilever chair"
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 70vw, 34vw"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Robert Straubmüller</span>
        <span>Co-founder of Levelwork, Konstanz</span>
      </figcaption>
    </figure>
    <p class="g-sub">Software for people who are not experts</p>
  </section>

  <section class="g-now" aria-labelledby="g-now-h">
    <h2 id="g-now-h" class="g-label">Now · Oct 2026</h2>
    <div>
      <p class="g-statement">
        Since 2026 I have been building <a href="https://levelwork.ai">Levelwork</a> full time with Michael Gajda. Constat
        shows how work is really distributed in an organisation, one structured conversation per role.
      </p>
      <ul class="g-also" aria-label="Also now">
        <li>
          <span class="g-also-title">AI meeting minutes</span>
          <span>In pilot at a district administration, freelance for gyv.</span>
        </li>
        <li>
          <span class="g-also-title">Notenprogramm</span>
          <span>Turns sheet-music PDFs into editable MusicXML.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="g-work" aria-labelledby="g-work-h">
    <div class="g-work-head">
      <h2 id="g-work-h" class="g-label">Selected work</h2>
      <p class="g-label">({String(selected.length).padStart(2, '0')})</p>
    </div>
    <ol class="g-grid">
      {
        selected.map((row) => (
          <li class="g-tile">
            <h3 class="g-title">{row.title}</h3>
            <div class="g-film">
              <video
                muted
                playsinline
                disablepictureinpicture
                preload="none"
                width="400"
                height="500"
                aria-hidden="true"
                data-src={`/motion/bauhaus/${slug(row.title)}.mp4`}
                data-poster={`/motion/bauhaus/${slug(row.title)}.jpg`}
              />
              <span class="g-year" aria-hidden="true">
                {row.years}
              </span>
            </div>
            <p class="g-meta">
              <span class="visually-hidden">{row.years}</span>
              {row.client === 'Own' ? <span class="is-own">Own project</span> : <span>For {row.client}</span>}
              {row.status && <span class:list={{ 'is-live': row.live }}>{row.status}</span>}
              {row.href && <a href={row.href}>{row.link} ↗</a>}
            </p>
            <p class="g-line">{row.line}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="g-awards" aria-labelledby="g-awards-h">
    <h2 id="g-awards-h" class="g-label">Awards</h2>
    <ol>
      {
        awards.map((award) => (
          <li>
            <span class="g-award">{award.title}</span>
            <span class="g-for">{award.for}</span>
            <span class="g-year-n">{award.year}</span>
            <span class="g-src">{award.href && <a href={award.href}>Source ↗</a>}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <a class="g-all" href="/varianten/g/work/">
    <span>All projects</span>
    <span class="g-all-n">{all.length} since {first} →</span>
  </a>

  <FFooter slot="footer" />

  <VariantSwitch />
</Base>

<script>
  // Films get their source when they come near, play once from the start when mostly in view,
  // and pause when they leave. Without motion only the poster, the last frame, is shown.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.g-film video')];
  const prepare = (video: HTMLVideoElement) => {
    if (video.src) return;
    video.poster = video.dataset.poster ?? '';
    video.src = video.dataset.src ?? '';
    video.preload = 'auto';
  };
  const near = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        prepare(entry.target as HTMLVideoElement);
        near.unobserve(entry.target);
      }),
    { rootMargin: '400px 0px' },
  );
  const seen = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (!entry.isIntersecting) return video.pause();
        if (reduce.matches) return;
        prepare(video);
        video.currentTime = 0;
        video.play().catch(() => {});
      }),
    { threshold: 0.6 },
  );
  videos.forEach((video) => {
    near.observe(video);
    seen.observe(video);
  });
</script>

<style>
  :global(body) {
    font-family: var(--f-sans);
    --signal: #e5361b;
  }

  .g-label {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Hero: the three words stacked on the left, Robert large on the right. */
  .g-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 24px clamp(24px, 4vw, 72px);
    align-items: end;
    padding: clamp(24px, 5vw, 80px) var(--m) clamp(56px, 7vw, 120px);
  }

  .g-words {
    margin: 0;
    font-size: clamp(56px, 11vw, 200px);
    font-weight: 500;
    line-height: 0.84;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .g-word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .g-word > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .g-word > span {
      animation: g-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0s) both;
    }
  }

  @keyframes g-rise {
    from {
      translate: 0 105%;
    }
  }

  .g-me {
    margin: 0;
  }

  .g-me :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .g-me figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding-top: 10px;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .g-sub {
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(16px, 1.75vw, 30px);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  /* Now and awards: a label column and a wide column, ruled. */
  .g-now,
  .g-awards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 16px var(--m);
    padding: 18px var(--m) 0;
    border-top: 1px solid var(--ink);
  }

  .g-now > div {
    padding-top: clamp(40px, 5vw, 96px);
  }

  .g-statement {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(26px, 3.3vw, 54px);
    font-weight: 500;
    line-height: 1.07;
    letter-spacing: -0.03em;
  }

  .g-statement a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .g-also {
    margin: clamp(32px, 4vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .g-also li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 4px var(--m);
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 17px;
  }

  .g-also-title {
    font-weight: 600;
  }

  /* Selected work: two staggered columns of films, like the project grid on Right Hemisphere. */
  .g-work {
    margin-top: clamp(80px, 10vw, 160px);
    padding: 18px var(--m) 0;
    border-top: 1px solid var(--ink);
  }

  .g-work-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(40px, 6vw, 96px);
  }

  .g-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(56px, 7vw, 128px) clamp(24px, 5vw, 96px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .g-tile:nth-child(even) {
    margin-top: clamp(96px, 18vw, 320px);
  }

  .g-title {
    margin: 0 0 18px;
    font-size: clamp(30px, 3.6vw, 60px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .g-film {
    position: relative;
    margin-right: 30px;
    aspect-ratio: 4 / 5;
    background: #f2eee3;
  }

  .g-film video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .g-year {
    position: absolute;
    top: 0;
    right: -26px;
    writing-mode: vertical-rl;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
  }

  .g-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 14px 0 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .g-meta a {
    text-decoration: none;
  }

  .g-meta a:hover {
    text-decoration: underline;
  }

  .is-own {
    padding: 0 6px;
    border: 1px solid currentColor;
  }

  .is-live::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background: var(--signal);
  }

  .g-line {
    max-width: 46ch;
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.45;
    color: var(--mute);
  }

  .g-awards {
    margin-top: clamp(80px, 10vw, 160px);
  }

  .g-awards ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .g-awards li {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 56px 80px;
    gap: 4px 16px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair);
  }

  .g-award {
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .g-for,
  .g-year-n {
    font-size: 15px;
    color: var(--mute);
  }

  .g-src {
    text-align: right;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .g-src a {
    text-decoration: none;
  }

  .g-all {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin: clamp(64px, 8vw, 140px) var(--m) 0;
    padding: 20px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: clamp(32px, 5vw, 84px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s,
      padding 0.25s;
  }

  .g-all-n {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .g-all:hover {
      padding-inline: 16px;
      background: var(--ink);
      color: var(--paper);
    }
  }

  @media (max-width: 760px) {
    .g-hero,
    .g-now,
    .g-awards {
      grid-template-columns: minmax(0, 1fr);
    }
    .g-me {
      max-width: 72%;
    }
    .g-words {
      font-size: 18.5vw;
    }
    .g-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .g-tile:nth-child(even) {
      margin-top: 0;
    }
    .g-also li,
    .g-awards li {
      grid-template-columns: minmax(0, 1fr);
    }
    .g-src {
      text-align: left;
    }
  }
</style>
