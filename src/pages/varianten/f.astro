---
// Draft variant F, in the direction of the three reference sites Robert sent (Right Hemisphere,
// ESR Bespoke, Obys Format): huge grotesk words across the width, small capitals on a grid, a big
// statement, and a dark band where the project in the middle of the screen lights up and its
// film plays in the frame next to it.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VariantSwitch from '../../components/VariantSwitch.astro';
import FHeader from '../../components/f/FHeader.astro';
import FFooter from '../../components/f/FFooter.astro';
import FilmFrame from '../../components/f/FilmFrame.astro';
import { awards } from '../../data/cv';
import { recent, brand, slug } from '../../data/projects';
import portrait from '../../assets/variants/portrait.jpg';

interface Row {
  years: string;
  title: string;
  line: string;
  /** Who the work was for. 'Own' marks self-initiated work. */
  client: string;
  status?: string;
  live?: boolean;
  href?: string;
  link?: string;
  /** Name of a film in /public/motion/f; without one the frame shows the project's title card. */
  film?: string;
}

const work: Row[] = [
  {
    years: '2026–',
    title: 'Levelwork',
    line: 'Co-founder. Constat shows how work is really distributed in an organisation.',
    client: 'Own',
    status: 'Startup',
    live: true,
    href: 'https://levelwork.ai',
    link: 'levelwork.ai',
    film: 'constat',
  },
  {
    years: '2026',
    title: 'AI meeting minutes',
    line: 'Product design and build, in pilot at a district administration.',
    client: 'gyv',
    status: 'Pilot',
    live: true,
  },
  {
    years: '2026',
    title: 'Saunter',
    line: 'Walk while you work: a walking-pad companion for the Mac, built with Claude Code.',
    client: 'Own',
    status: 'Open source',
    live: true,
    href: 'https://github.com/RobStraubm/saunter',
    link: 'GitHub',
    film: 'saunter',
  },
  {
    years: '2026',
    title: 'SayFit',
    line: 'Voice food logger, team of four. Co-built the pipeline, tests and web UI.',
    client: 'Own',
    status: 'Team project',
    href: 'https://github.com/RobStraubm/sayfit',
    link: 'GitHub',
  },
  {
    years: '2022–25',
    title: 'Flowculate',
    line: 'From a math-only research tool to a public web app. Concept, UI, brand, project lead.',
    client: 'HTWG Konstanz',
    status: 'Live',
    live: true,
    href: 'https://flowculate.eu',
    link: 'flowculate.eu',
    film: 'flowculate',
  },
  {
    years: '2024',
    title: 'Sustainable IoT',
    line: 'A design sprint that turned an IoT lab towards ecological footprints.',
    client: 'HTWG Konstanz',
    status: 'Research',
  },
  {
    years: '2022–24',
    title: 'Tealucent',
    line: 'Design system for goconut’s small developer team, tested with ten people.',
    client: 'user generated design',
    status: 'User-tested',
  },
  {
    years: '2022',
    title: 'Conactive',
    line: 'Master’s thesis on interacting with connected systems.',
    client: 'Own',
    status: '1st prize',
    href: 'https://www.htwg-konstanz.de/bachelor/kommunikationsdesign/abschlussarbeiten/konstanzer-designpreis/straubueller-robert',
    link: 'HTWG',
  },
  {
    years: '2021',
    title: 'Stayin’ Alive',
    line: 'Exhibition on living with epidemics, built by about 80 students. Led the UX team.',
    client: 'HTWG Konstanz',
    status: 'Red Dot',
    href: 'https://www.red-dot.org/project/stayin-alive-60726',
    link: 'red-dot.org',
  },
];

const frameItems = work.map((row) => ({
  key: slug(row.title),
  film: row.film ? { src: `/motion/f/${row.film}.mp4`, poster: `/motion/f/${row.film}.jpg` } : undefined,
  still: row.film ? undefined : `/motion/f/card-${slug(row.title)}.jpg`,
}));

const all = [...recent, ...brand];
const first = Math.floor(Math.min(...all.map((item) => item.start)));
---

<Base
  title="Robert Straubmüller · Version F"
  description="Robert Straubmüller researches, designs and builds software for people who are not experts. Co-founder of Levelwork, Konstanz."
  chrome={false}
>
  <FHeader slot="header" />

  <section class="f-hero" aria-labelledby="f-hero-h">
    <h1 id="f-hero-h" class="f-words">
      <span class="visually-hidden">I research, design and build software for people who are not experts.</span>
      <span class="f-word" aria-hidden="true"><span>Research</span></span>
      <span class="f-word" aria-hidden="true" style="--delay: 0.08s"><span>Design</span></span>
      <span class="f-word" aria-hidden="true" style="--delay: 0.16s"><span>Build</span></span>
    </h1>
    <p class="f-sub" aria-hidden="true">Software for people who are not experts</p>
    <div class="f-hero-foot">
      <figure class="f-me">
        <Image
          src={portrait}
          alt="Robert Straubmüller, smiling, seated on a cantilever chair"
          widths={[240, 480]}
          sizes="180px"
          loading="eager"
        />
        <figcaption>Robert Straubmüller<br />Co-founder of Levelwork<br />Konstanz</figcaption>
      </figure>
      <a class="f-down" href="#f-now">Now ↓</a>
    </div>
  </section>

  <section id="f-now" class="f-now" aria-labelledby="f-now-h">
    <h2 id="f-now-h" class="f-label">Now · Oct 2026</h2>
    <div>
      <p class="f-statement">
        Since 2026 I have been building <a href="https://levelwork.ai">Levelwork</a> full time with Michael Gajda. Constat
        shows how work is really distributed in an organisation, one structured conversation per role.
      </p>
      <ul class="f-also" aria-label="Also now">
        <li>
          <span class="f-also-title">AI meeting minutes</span>
          <span>In pilot at a district administration, freelance for gyv.</span>
        </li>
        <li>
          <span class="f-also-title">Notenprogramm</span>
          <span>Turns sheet-music PDFs into editable MusicXML.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="f-work" aria-labelledby="f-work-h">
    <div class="f-work-head">
      <h2 id="f-work-h" class="f-label">Selected work</h2>
      <p class="f-label">{String(work.length).padStart(2, '0')} projects</p>
    </div>
    <div class="f-work-grid">
      <ol class="f-list">
        {
          work.map((row) => (
            <li data-film-key={slug(row.title)}>
              <h3 class="f-title">{row.title}</h3>
              <p class="f-meta">
                <span>{row.years}</span>
                {row.client === 'Own' ? (
                  <span class="is-own">Own project</span>
                ) : (
                  <span>For {row.client}</span>
                )}
                {row.status && <span class:list={{ 'is-live': row.live }}>{row.status}</span>}
                {row.href && <a href={row.href}>{row.link} ↗</a>}
              </p>
              <p class="f-line">{row.line}</p>
            </li>
          ))
        }
      </ol>
      <FilmFrame items={frameItems} />
    </div>
  </section>

  <section class="f-awards" aria-labelledby="f-awards-h">
    <h2 id="f-awards-h" class="f-label">Awards</h2>
    <ol>
      {
        awards.map((award) => (
          <li>
            <span class="f-award">{award.title}</span>
            <span class="f-for">{award.for}</span>
            <span class="f-year">{award.year}</span>
            <span class="f-src">{award.href && <a href={award.href}>Source ↗</a>}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <a class="f-all" href="/varianten/f/work/">
    <span>All projects</span>
    <span class="f-all-n">{all.length} since {first} →</span>
  </a>

  <FFooter slot="footer" />

  <VariantSwitch />
</Base>

<style>
  :global(body) {
    font-family: var(--f-sans);
  }

  .f-label {
    margin: 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Hero: three words spread across the full width, as on the reference sites. */
  .f-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - 72px);
    padding: 0 var(--m) clamp(24px, 3vw, 40px);
  }

  .f-words {
    display: flex;
    justify-content: space-between;
    margin: auto 0 0;
    font-size: clamp(44px, 7.6vw, 132px);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .f-word {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .f-word > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .f-word > span {
      animation: f-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay, 0s) both;
    }
  }

  @keyframes f-rise {
    from {
      translate: 0 105%;
    }
  }

  .f-sub {
    align-self: flex-end;
    margin: 18px 0 0;
    font-size: clamp(16px, 1.75vw, 30px);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .f-hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-top: auto;
    padding-top: 40px;
  }

  .f-me {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    margin: 0;
  }

  .f-me :global(img) {
    width: clamp(104px, 11vw, 180px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .f-me figcaption,
  .f-down {
    font-family: var(--f-mono);
    font-size: 11.5px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .f-down {
    text-decoration: none;
  }

  .f-down:hover {
    text-decoration: underline;
  }

  /* Now: one big statement, the way ESR sets its paragraphs. */
  .f-now,
  .f-awards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 16px var(--m);
    padding: clamp(64px, 8vw, 140px) var(--m) 0;
  }

  .f-now {
    border-top: 1px solid var(--ink);
    padding-top: 18px;
    margin-top: 0;
  }

  .f-now > div {
    padding-top: clamp(48px, 6vw, 110px);
  }

  .f-statement {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(26px, 3.3vw, 54px);
    font-weight: 500;
    line-height: 1.07;
    letter-spacing: -0.03em;
  }

  .f-statement a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .f-also {
    margin: clamp(32px, 4vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .f-also li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 4px var(--m);
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
    font-size: 17px;
  }

  .f-also-title {
    font-weight: 600;
  }

  /* Selected work: a dark band; the row in the middle of the screen lights up. */
  .f-work {
    --band: #0e0f0e;
    --band-ink: #e7e8e3;
    --band-dim: rgb(231 232 227 / 0.42);
    --band-quiet: rgb(231 232 227 / 0.62);
    --band-hair: rgb(231 232 227 / 0.16);
    --signal: #ff6a4d;
    margin-top: clamp(80px, 10vw, 160px);
    padding: 18px var(--m) clamp(80px, 10vw, 160px);
    background: var(--band);
    color: var(--band-ink);
  }

  .f-work-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: clamp(40px, 6vw, 96px);
  }

  .f-work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 32%);
    gap: 0 clamp(24px, 4vw, 72px);
  }

  .f-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .f-list li {
    padding: 22px 0 26px;
    border-top: 1px solid var(--band-hair);
    color: var(--band-dim);
    transition: color 0.35s;
  }

  .f-list li.is-active,
  .f-list li.is-active .f-meta,
  .f-list li.is-active .f-line {
    color: var(--band-ink);
  }

  .f-meta,
  .f-line {
    color: var(--band-quiet);
    transition: color 0.35s;
  }

  .f-title {
    margin: 0;
    font-size: clamp(34px, 4.7vw, 80px);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .f-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 14px 0 0;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .f-meta a {
    text-decoration: none;
  }

  .f-meta a:hover {
    text-decoration: underline;
  }

  .is-own {
    padding: 0 6px;
    border: 1px solid currentColor;
  }

  .is-live::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background: var(--signal);
  }

  .f-line {
    max-width: 46ch;
    margin: 8px 0 0;
    font-size: 16px;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .f-list li {
      transition: none;
    }
  }

  /* Awards: a ruled list, like the mentions on Right Hemisphere. */
  .f-awards ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .f-awards li {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) 56px 80px;
    gap: 4px 16px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair);
  }

  .f-award {
    font-size: clamp(18px, 1.6vw, 24px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .f-for,
  .f-year {
    font-size: 15px;
    color: var(--mute);
  }

  .f-src {
    text-align: right;
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .f-src a {
    text-decoration: none;
  }

  /* The way to everything else: one ruled line that inverts under the pointer. */
  .f-all {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin: clamp(64px, 8vw, 140px) var(--m) 0;
    padding: 20px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: clamp(32px, 5vw, 84px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s,
      padding 0.25s;
  }

  .f-all-n {
    font-family: var(--f-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .f-all:hover {
      padding-inline: 16px;
      background: var(--ink);
      color: var(--paper);
    }
  }

  @media (max-width: 1100px) {
    .f-work-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .f-work-grid > :global(.ffr) {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .f-words {
      flex-direction: column;
      font-size: 18.5vw;
    }
    .f-sub {
      align-self: flex-start;
    }
    .f-now,
    .f-awards {
      grid-template-columns: minmax(0, 1fr);
    }
    .f-also li,
    .f-awards li {
      grid-template-columns: minmax(0, 1fr);
    }
    .f-src {
      text-align: left;
    }
  }
</style>
