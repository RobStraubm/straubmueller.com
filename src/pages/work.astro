---
// All projects (version I): the full index behind the homepage selection, old work included (as in E).
import Base from '../layouts/Base.astro';
import { recent, brand } from '../data/projects';

const groups = [
  { id: 'recent', title: 'Products, research and UX', items: recent },
  { id: 'brand', title: 'Brand, editorial and photography', items: brand },
].map((group) => ({ ...group, items: [...group.items].sort((a, b) => b.start - a.start) }));

/** Projects with a case study page. */
const cases: Record<string, string> = {
  Levelwork: '/work/levelwork/',
  Flowculate: '/work/flowculate/',
  Saunter: '/work/saunter/',
  'Colla parte': '/work/colla-parte/',
  Belegscanner: '/work/belegscanner/',
  SayFit: '/work/sayfit/',
  Ambacta: '/work/meeting-minutes/',
  'Sustainable IoT': '/work/sustainable-iot/',
  Tealucent: '/work/tealucent/',
  Conactive: '/work/conactive/',
  'Stayin’ Alive': '/work/stayin-alive/',
};

const all = [...recent, ...brand];
const first = Math.floor(Math.min(...all.map((item) => item.start)));
---

<Base
  title="All projects · Robert Straubmüller"
  description="Every project by Robert Straubmüller: products, research and UX, and earlier brand, editorial and photography work."
  chrome={false}
>
  <header class="e-header bar" slot="header">
    <a class="e-name" href="/">Robert Straubmüller</a>
    <span>Co-founder, Levelwork</span>
    <span class="e-place">Konstanz</span>
    <span class="e-links">
      <a href="/work/" aria-current="page">Projects</a>
      <a href="/about/">About</a>
      <a href="mailto:robert@straubmueller.com">Email</a>
      <a href="https://www.linkedin.com/in/robert-straubmueller">LinkedIn</a>
      <a href="https://github.com/RobStraubm">GitHub</a>
    </span>
  </header>

  <div class="e-page">
    <h1 class="e-statement">All projects</h1>
    <p class="e-intro mute">{all.length} projects since {first}, newest first in each group. “Own” marks self-initiated work.</p>

    {
      groups.map((group) => (
        <section class="e-list" aria-labelledby={`e-${group.id}`}>
          <h2 id={`e-${group.id}`} class="e-list-h">
            {group.title}
          </h2>
          <p class="e-cols mute" aria-hidden="true">
            <span>Year</span>
            <span>Project</span>
            <span />
            <span>Client</span>
            <span>Field</span>
          </p>
          <ol class="e-rows">
            {group.items.map((item) => (
              <li class:list={{ 'is-case': cases[item.title] }}>
                <span class="e-years">{item.years}</span>
                <span class="e-title">{cases[item.title] ? <a href={cases[item.title]}>{item.title} →</a> : item.title}</span>
                <span class="e-line">{item.line}</span>
                <span class="e-meta">
                  <span class:list={['e-client', { 'is-own': item.client === 'Own' }]}>
                    <span class="visually-hidden">Client: </span>
                    {item.client}
                  </span>
                  <span class="e-field">{item.field}</span>
                </span>
                <span class="e-link">{item.href && <a href={item.href}>{item.link} ↗</a>}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <footer class="e-footer" slot="footer">
    <p><a href="/">← Back to the homepage</a></p>
    <p class="e-legal">
      <a href="/colophon/">Colophon</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="https://github.com/RobStraubm/straubmueller.com">Source</a>
    </p>
  </footer>

</Base>

<style>
  :global(body) {
    font-family: var(--f-sans);
  }

  .e-header {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr auto;
    gap: 8px 24px;
    padding: 18px var(--m);
    font-size: 15px;
  }

  .e-name {
    font-weight: 600;
    text-decoration: none;
  }

  .e-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }

  .e-links a,
  .e-legal a,
  .e-link a,
  .e-footer a {
    text-decoration: none;
  }

  .e-links a:hover,
  .e-links a[aria-current='page'],
  .e-legal a:hover,
  .e-link a:hover,
  .e-footer a:hover {
    text-decoration: underline;
  }

  .e-page {
    padding: clamp(40px, 6vw, 96px) var(--m) 0;
  }

  .e-statement {
    margin: 0;
    font-size: clamp(40px, 5.6vw, 100px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .e-intro {
    max-width: 60ch;
    margin: 20px 0 0;
    font-size: 17px;
  }

  .e-list {
    margin-top: clamp(48px, 6vw, 96px);
  }

  .e-list-h {
    margin: 0;
    padding-bottom: 12px;
    font-size: 15px;
    font-weight: 600;
  }

  .e-cols,
  .e-rows li {
    display: grid;
    grid-template-columns: 64px minmax(0, 0.7fr) minmax(0, 1.5fr) 180px 104px 108px;
    gap: 4px 16px;
    align-items: baseline;
  }

  .e-cols {
    margin: 0;
    padding: 0 0 8px;
    font-size: 13px;
  }

  .e-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .e-rows li {
    padding: 14px 0 13px;
    border-bottom: 1px solid var(--hair);
  }

  /* A row with a case study is its link as a whole: the title's link reaches over the row, the row's own
     outside link stays on top of it. */
  .e-rows li.is-case {
    position: relative;
  }

  .e-rows li.is-case .e-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .e-rows li.is-case .e-link a {
    position: relative;
    z-index: 1;
  }

  .e-rows li.is-case:hover .e-line {
    color: var(--ink);
  }

  .e-years {
    font-size: 14px;
    color: var(--mute);
    font-variant-numeric: tabular-nums;
  }

  .e-title {
    font-size: clamp(18px, 1.4vw, 22px);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .e-line {
    font-size: 15px;
    color: var(--mute);
  }

  .e-meta {
    display: contents;
  }

  .e-client,
  .e-field,
  .e-link {
    font-size: 14px;
  }

  .e-client,
  .e-field {
    color: var(--mute);
  }

  .e-client.is-own {
    color: var(--ink);
    font-weight: 600;
  }

  .e-link {
    text-align: right;
    white-space: nowrap;
  }

  .e-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(64px, 8vw, 128px);
    padding: 20px var(--m) 72px;
    border-top: 1px solid var(--ink);
    font-size: 15px;
  }

  .e-footer p {
    margin: 0;
  }

  .e-legal {
    display: flex;
    gap: 18px;
  }

  @media (max-width: 1100px) {
    .e-cols {
      display: none;
    }
    .e-rows li {
      grid-template-columns: 64px minmax(0, 1fr) auto;
    }
    .e-title,
    .e-line {
      grid-column: 2;
    }
    .e-meta {
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 2px 16px;
    }
    .e-link {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 640px) {
    .e-header {
      grid-template-columns: 1fr auto;
    }
    .e-place {
      display: none;
    }
    .e-links {
      grid-column: 1 / -1;
    }
    .e-rows li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .e-years {
      grid-column: 1 / -1;
    }
    .e-title,
    .e-line,
    .e-meta {
      grid-column: 1;
    }
    .e-link {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
