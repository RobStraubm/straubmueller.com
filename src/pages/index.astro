---
import Base from '../layouts/Base.astro';
---

<Base
  title="Robert Straubmüller"
  description="Robert Straubmüller: UX research, interface design and front-end code. Konstanz and Stuttgart."
>
  <header class="bar mono">
    <span>Robert Straubmüller</span>
    <span>Konstanz · Stuttgart</span>
  </header>

  <main>
    <p class="mono label">UX research · Interface design · Front-end code</p>
    <h1>This site is being rebuilt, in public.</h1>
    <p class="lede">
      Until it is finished, my case studies live on <a href="https://straubmuellerstudios.com">straubmuellerstudios.com</a>.
    </p>
  </main>

  <footer class="bar mono">
    <span>robert@straubmueller.com</span>
    <a href="https://github.com/RobStraubm/straubmueller.com">Source on GitHub</a>
  </footer>
</Base>

<style>
  .mono {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px clamp(16px, 3vw, 40px);
  }
  header.bar { border-bottom: 1px solid var(--ink); }
  footer.bar { border-top: 1px solid var(--rule); }
  main {
    min-height: calc(100svh - 96px);
    display: grid;
    align-content: center;
    gap: 28px;
    padding: 64px clamp(16px, 3vw, 40px);
    max-width: 1360px;
  }
  .label { margin: 0; color: var(--mute); }
  h1 {
    margin: 0;
    font-weight: 400;
    font-size: clamp(40px, 8vw, 112px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .lede { margin: 0; font-size: clamp(18px, 1.6vw, 22px); max-width: 44ch; }
</style>
