          broke: 'About one mark in fifteen sat beside the printed note, and the whole PDF page was too small to compare.',
          changed: 'Marks snap to the printed note head; the same bars are shown large next to the transcription.',
          numbers: ['1 in 15 off', 'on the note'],
        },
        {
          date: '26 Oct',
          broke: 'A tenor line read an octave too low produced a question for every note.',
          changed: 'One question for the whole line.',
          numbers: ['22 questions', '10'],
        },
