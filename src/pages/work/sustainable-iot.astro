          label="Storyboard"
          alt="Whiteboard storyboard in ten panels, from has a sustainability question and load model to compare scenarios and print results"
          widths={[800, 1600]}
          sizes={half}
        />
        <figcaption>From a sustainability question to printed results, in ten panels.</figcaption>
      </figure>
    </div>
    <div class="c-split" style={row(flowWall, flipchart)}>
      <figure>
        <Shot
          src={flowWall}
          source="Design sprint, March 2024"
          label="Flow"
