// 2026), the capstone 1 slides (~/bootcamp/capstone1/presentation_slides_en.txt: 29 tests, 11 runs, ~12 % → ~71 %)
// and the capstone 2 deck (~/bootcamp/capstone2/SayFit_Capstone2.pptx: roles, V3 → V4, prompt lengths).
// Run 09 used simpler test cases (slides), so the case does not quote its score. The 12 → 71 % is the pipeline's own
// confidence, not accuracy against known answers; no accuracy figure exists, so none is claimed (Robert, 27 Oct 2026).
import CaseLayout from '../../components/case/CaseLayout.astro';
