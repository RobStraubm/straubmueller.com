---
import '@fontsource-variable/noto-serif-display/wdth.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/fragment-mono/400.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Render the shared header and footer. Draft variants bring their own. */
  chrome?: boolean;
}
const { title, description, chrome = true } = Astro.props;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Robert Straubmüller',
  url: 'https://straubmueller.com',
  email: 'mailto:robert@straubmueller.com',
  jobTitle: 'Co-founder',
  worksFor: { '@type': 'Organization', name: 'Levelwork', url: 'https://levelwork.ai' },
  knowsAbout: ['UX research', 'Interface design', 'Design systems', 'AI engineering'],
  address: { '@type': 'PostalAddress', addressLocality: 'Konstanz', addressCountry: 'DE' },
  sameAs: ['https://github.com/RobStraubm', 'https://www.linkedin.com/in/robert-straubmueller'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Palette comparison, local only: ?palette=bw or the switch at the bottom left sets it, and it is remembered.
      (() => {
        if (!['localhost', '127.0.0.1'].includes(location.hostname)) return;
        const asked = new URLSearchParams(location.search).get('palette');
        try {
          if (asked) localStorage.setItem('palette', asked);
          const palette = asked ?? localStorage.getItem('palette');
          if (palette === 'bw') document.documentElement.dataset.palette = 'bw';
        } catch {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {chrome && <SiteHeader />}
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    {chrome && <SiteFooter />}
    <slot name="footer" />
    <script is:inline>
      // The switch for the palette comparison, shown only on this machine.
      if (['localhost', '127.0.0.1'].includes(location.hostname)) {
        const bw = document.documentElement.dataset.palette === 'bw';
        const box = document.createElement('div');
        box.className = 'palette-switch';
        box.setAttribute('aria-label', 'Palette');
        for (const [key, label] of [['original', 'Original'], ['bw', 'Schwarz-Weiß']]) {
          const button = document.createElement('button');
          button.type = 'button';
          button.textContent = label;
          button.setAttribute('aria-pressed', String((key === 'bw') === bw));
          button.addEventListener('click', () => {
            try { localStorage.setItem('palette', key); } catch {}
            const url = new URL(location.href);
            url.searchParams.delete('palette');
            location.href = url.toString();
          });
          box.append(button);
        }
        document.body.append(box);
      }
    </script>
    <script>
      // The bar's height, which wraps to two lines on a phone, for the room the page keeps above its content.
      const bar = document.querySelector<HTMLElement>('.bar');
      if (bar) {
        const set = () => document.documentElement.style.setProperty('--bar-h', `${bar.offsetHeight}px`);
        new ResizeObserver(set).observe(bar);
        set();
      }
    </script>
  </body>
</html>
